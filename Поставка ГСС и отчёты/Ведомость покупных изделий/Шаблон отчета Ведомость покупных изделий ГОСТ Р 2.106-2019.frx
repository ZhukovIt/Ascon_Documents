    private void PrintFirstPage(ArrayList fList, ArrayList secList)
    {
      PageFooter1.Height = PAGEFOOTER1_HEIGHT;
        
      for (int i = 0; i &lt; fList.Count; i++)
      {
        ((TextObject)fList[i]).Visible = true;
      }
        
