  #region Вспомогательные методы для работы с текстом
    
    public static List&lt;string&gt; SplitByPixelLength(TextObject aTextObject, string text)
    {
            
      var lines = new List&lt;string&gt;();
      var words = text.Split(' ');
      var currentLine = &quot;&quot;;
      float maxPixelWidth = aTextObject.Width;

      // Create a dummy bitmap for MeasureString
      using (var bmp = new Bitmap(1, 1))
      using (var g = Graphics.FromImage(bmp))
      {
        foreach (var word in words)
        {
          string potentialLine = string.IsNullOrEmpty(currentLine) ? word : currentLine + &quot; &quot; + word;
            
          // Measure the width of the potential line
          var size = g.MeasureString(potentialLine, aTextObject.Font);

          if (size.Width &gt; maxPixelWidth)
          {
            // Line is too long, add currentLine to list and start new line
            lines.Add(currentLine);
            currentLine = word;
          }
          else
          {
            currentLine = potentialLine;
          }
        }
        lines.Add(currentLine); // Add the last line
      }
      
      return lines;
    }
    
        
    private string SeekNTD(string stText, string NTD)
    {
      int posStart = stText.IndexOf(NTD);
      if (posStart &lt; 0)
        return &quot;&quot;;
        
      string result = &quot;&quot;;
      int lenNTD = 0;
      string SymbolNTD = stText.Substring(posStart, 1);
        
      for (int ii = 1; ii &lt;= NTD.Length; ii++)
      {
        result += SymbolNTD;
        lenNTD++;
        if (posStart + lenNTD &lt; stText.Length)
          SymbolNTD = stText.Substring(posStart + lenNTD, 1);
      }
        
      for (int ii = lenNTD; ii &lt;= stText.Length; ii++)
      {
        result += SymbolNTD;
        lenNTD++;
        if (posStart + lenNTD &lt; stText.Length)
          SymbolNTD = stText.Substring(posStart + lenNTD, 1);
        else
          break;
            
        if (SymbolNTD == &quot;/&quot; || SymbolNTD == &quot; &quot; || SymbolNTD == &quot;,&quot;)
          break;
      }
        
      return result;
    }
    
    
    private string GetCustomNTD(string stText, out int posNTD, out int lenNTD)
    {
      string stNTD = SeekNTD(stText, &quot;ГОСТ Р &quot;);
      if (string.IsNullOrEmpty(stNTD))
        stNTD = SeekNTD(stText, &quot;ГОСТ &quot;);
      if (string.IsNullOrEmpty(stNTD))
        stNTD = SeekNTD(stText, &quot;ОСТ &quot;);
      if (string.IsNullOrEmpty(stNTD))
        stNTD = SeekNTD(stText, &quot;СТО &quot;);
      if (string.IsNullOrEmpty(stNTD))
        stNTD = SeekNTD(stText, &quot;СТП &quot;);
      if (string.IsNullOrEmpty(stNTD))
        stNTD = SeekNTD(stText, &quot;ТУ &quot;);
        
      posNTD = stText.IndexOf(stNTD);
      lenNTD = !string.IsNullOrEmpty(stNTD) ? stNTD.Length : 0;
      
      //заменим внутри НТД простой пробел неразрывным
      stNTD = stNTD.Replace(&quot; &quot;, &quot;\u00A0&quot;);
      
      if (!string.IsNullOrEmpty(stNTD))
        return stNTD;
        
      return &quot;&quot;;
    }
    
    
    private string NoWrapNTD(string stMemoText)
    {
      string stResult = &quot;&quot;;
      string remainingText = stMemoText;
        
      while (remainingText.Length &gt; 0)
      {
        int posNTD, lenNTD;
        string stNTD = GetCustomNTD(remainingText, out posNTD, out lenNTD);
            
        if (posNTD == 0 || string.IsNullOrEmpty(stNTD))
        {
          stResult += remainingText;
          remainingText = &quot;&quot;;
        }
        else
        {
          stResult += remainingText.Substring(0, posNTD) + stNTD;
          int startIndex = posNTD + lenNTD;
          remainingText = startIndex &lt; remainingText.Length ? remainingText.Substring(startIndex) : &quot;&quot;;
        }
      }
        
      return stResult;
    }
    
