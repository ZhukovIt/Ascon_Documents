      Line28.Visible = false;
      Line29.Visible = false;
      Line30.Visible = false;

      sht_Line3.Visible = true;
      sht_Line4.Visible = true;
      
    }
    
    
    private void PrintOtherPages(ArrayList fList, ArrayList secList)
