    private void _StartReport(object sender, EventArgs e)
    {
      list = new List&lt;string&gt;();
      slMemoName = new List&lt;string&gt;();
      //MemoFake = new TextObject();
        
      GroupHeader1.KeepTogether = GROUPHEADER1_KEEPTOGETHER == 1;
       // добавим пустую строку между наименованиями
      Data1.RowCount = ADDSTR_BEETWEEN;       
    }
    
    
    public void GroupFooter3_BeforePrint(object sender, EventArgs e)
    {
      bool vs = nameNom &gt; 1;
        
      int priznakIsklucheniya = Convert.ToInt32(Report.GetColumnValue(&quot;cds_SQL.Признак исключения&quot;));
      if (priznakIsklucheniya == 1)
        vs = false;
        
      GroupFooter3.Visible = vs;
    }


    public void GroupHeader3_BeforePrint(object sender, EventArgs e)
    {
      nameNom = 0;
    }


    public void GroupHeader1_BeforePrint(object sender, EventArgs e)
    {
      string vidIzdeliya = ((string)Report.GetColumnValue(&quot;DATA.Вид Изделия&quot;));
      GroupHeader1.Visible = !(string.IsNullOrEmpty(vidIzdeliya));
      Child1.Visible = GroupHeader1.Visible &amp;&amp; (ADDSTR_BEETWEEN &gt; 0);
    }
    

    public void MasterData1_BeforePrint(object sender, EventArgs e)
    {        
      nameNom++;
      if (nameNom &gt; 1)
      {
        Memo14.Visible = false;
        Memo17.Visible = false;
      }
      else
      {
        Memo14.Visible = true;
        Memo17.Visible = true;
      }

    }
    

    public void Overlay1_BeforePrint(object sender, EventArgs e)
    {
      int p = ((Int32)Report.GetVariableValue(&quot;Page&quot;));
      if (p &lt;= 2)
      {
        ArrayList fList = new ArrayList();
        ArrayList secList = new ArrayList();
        ArrayList overList = new ArrayList();
            
        FillMemosLists(fList, secList);
            
        if (p == 1)
          PrintFirstPage(fList, secList);
        else
          PrintOtherPages(fList, secList);
      }
    }


    private void Page1_FinishPage(object sender, EventArgs e)
    {
      Page2.Visible = false;
    }


    private void Memo14_BeforePrint(object sender, EventArgs e)
    {
      TextObject textObject = sender as TextObject;
      if (textObject != null)
      {  
        string dataValue = ((string)Report.GetColumnValue(&quot;DATA.Наименование&quot;));
        dataValue = &quot;раз: &quot;+dataValue + &quot; два: &quot;+dataValue +&quot; и три: &quot;+ dataValue;

        Data1.RowCount = 0;
        slMemoName = SplitByPixelLength(Memo14, NoWrapNTD(dataValue));       

        if (slMemoName.Count &gt; 0)
        {
          // добавим пустую строку между наименованиями
          for (int idx = 1; idx &lt;= ADDSTR_BEETWEEN; idx++)
          {
            slMemoName.Add(&quot;&quot;);
          }
          
          textObject.Text = slMemoName[0];
          Data1.RowCount = slMemoName.Count-1;
        }
        
      }  
    }
    

    private void Data1_BeforePrint(object sender, EventArgs e)
    {
      TextObject textObject = TextEnd as TextObject;
      if (textObject != null)
      {
        textObject.Text = slMemoName[Data1.RowNo];
      }
      
    }
